<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      ViKom brand tokens, ported from the web app's :root block in
      ViKom/frontend/src/index.css so both halves of the product share one palette.
      Keep names and values in sync with that file — it is the source of truth.
    -->

    <!-- Brand -->
    <color name="vk_primary">#7C56E3</color>
    <color name="vk_primary_pressed">#6B47C9</color>
    <color name="vk_secondary">#1E214C</color>
    <color name="vk_secondary_pressed">#151742</color>
    <color name="vk_info">#1932B2</color>

    <!--
      Focus states. The web app expresses focus as a translucent ring (its
      focus-ring token is the primary colour at 20% alpha); Android selector
      drawables here fill the focused state instead, so vk_primary_focus is a
      lighter tint of vk_primary derived for that purpose. It has no direct web
      counterpart.
    -->
    <color name="vk_primary_focus">#9679E8</color>
    <color name="vk_focus_ring">#337C56E3</color>

    <!--
      Disabled fills. The web app renders these as the base colour at reduced
      opacity (Bootstrap's default); Android selector items need an opaque value,
      so these are the equivalent flattened tints against a white surface.
    -->
    <color name="vk_primary_disabled">#C9BAF3</color>
    <color name="vk_secondary_disabled">#A5A7BE</color>
    <color name="vk_danger_disabled">#EFA6AE</color>

    <!--
      Focused tints. Every interactive surface focuses to a lighter tint of its
      own colour so D-pad focus stays legible without borrowing another role's
      colour. Derived here; the web app has no equivalent (it uses a ring).
    -->
    <color name="vk_secondary_focus">#3A3E70</color>
    <color name="vk_danger_focus">#E4606D</color>

    <!-- Very light primary wash, for card surfaces and focused card fills. -->
    <color name="vk_primary_surface">#F1ECFC</color>

    <!-- Status -->
    <color name="vk_success">#28A745</color>
    <color name="vk_success_soft">#5DC36E</color>
    <color name="vk_warning">#FFC107</color>
    <color name="vk_danger">#DC3545</color>
    <color name="vk_danger_pressed">#C82333</color>

    <!-- Neutrals -->
    <color name="vk_white">#FFFFFF</color>
    <color name="vk_gray_100">#F8F9FA</color>
    <color name="vk_gray_200">#E9ECEF</color>
    <color name="vk_gray_300">#DEE2E6</color>
    <color name="vk_gray_400">#CED4DA</color>
    <color name="vk_gray_500">#ADB5BD</color>
    <color name="vk_gray_600">#6C757D</color>
    <color name="vk_gray_700">#495057</color>
    <color name="vk_gray_800">#343A40</color>
    <color name="vk_gray_900">#111215</color>

    <!-- Semantic neutrals -->
    <color name="vk_text_primary">@color/vk_gray_900</color>
    <color name="vk_text_muted">@color/vk_gray_600</color>
    <color name="vk_border">@color/vk_gray_300</color>
    <color name="vk_surface">@color/vk_white</color>
    <color name="vk_surface_muted">@color/vk_gray_100</color>

    <!-- Danger / success surfaces (shared by alerts) -->
    <color name="vk_danger_surface_bg">#F8D7DA</color>
    <color name="vk_danger_surface_fg">#842029</color>
    <color name="vk_danger_surface_border">#F5C2C7</color>
    <color name="vk_success_surface_bg">#D4EDDA</color>
    <color name="vk_success_surface_fg">#155724</color>
    <color name="vk_success_surface_border">#C3E6CB</color>

    <!-- Pre-existing colours, kept so current references keep resolving. -->
    <color name="background_gradient_start">#000000</color>
    <color name="background_gradient_end">#DDDDDD</color>
    <color name="default_background">#FFFFFF</color>
    <color name="speaker_active">@color/vk_success</color>
</resources>

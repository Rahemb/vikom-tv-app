<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_large"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    
    <include layout="@layout/view_screen_header" />

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/content_area_background"
        android:padding="8dp">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/input_field_background">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_hint" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/vk_text_primary"
                    android:textColorHint="@color/vk_gray_500"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:paddingEnd="8dp"
                    android:nextFocusDown="@id/contacts_list"
                    tools:ignore="VisualLintTextFieldSize,Autofill" />

                <ImageView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/search_clear"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/search_button"
                android:textSize="@dimen/search_button_text"
                android:textColor="@color/vk_white"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/button_search_background"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contacts_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

</LinearLayout>

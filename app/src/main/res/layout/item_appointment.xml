<?xml version="1.0" encoding="utf-8"?>
<!--
  One appointment row. An XML layout rather than views built in Kotlin (as
  ContactGridAdapter does), so the dimens system actually applies — on a Galaxy
  Tab A8 that means 22sp body text and a 72dp minimum row height.

  focusable + clickable are required, not decorative: a RecyclerView only scrolls
  under D-pad control when its children can take focus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/appointment_card_background"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_height"
    android:orientation="horizontal"
    android:padding="@dimen/padding_standard">

    <!-- When -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_appointment_date"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txt_appointment_time"
            style="@style/VK.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_clock"
            android:textColor="@color/vk_gray_700" />
    </LinearLayout>

    <!-- Who and what -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_standard"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_appointment_personnel"
            style="@style/VK.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txt_appointment_tasks"
            style="@style/VK.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>

    <!-- Status badge; background is swapped in code per status -->
    <TextView
        android:id="@+id/txt_appointment_status"
        style="@style/VK.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_chip_booked"
        android:paddingHorizontal="@dimen/padding_standard"
        android:paddingVertical="8dp"
        android:textColor="@color/vk_white"
        android:textStyle="bold" />
</LinearLayout>

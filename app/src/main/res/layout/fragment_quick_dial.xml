<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_large"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    
    <include layout="@layout/view_main_tabs" />

    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/content_area_background"
            android:padding="8dp">

            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/txt_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Innlogget"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/vk_text_primary"
                    android:drawableStart="@drawable/green_circle_button"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical" />
            </LinearLayout>

            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contacts_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            
            <LinearLayout
                android:id="@+id/favorites_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/txt_favorites_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ Favoritter"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/vk_text_primary" />

                
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#BDBDBD"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favorites_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Poppins — body/UI typeface, matching the web app's font-primary token.
  Static instances bundled from google/fonts (OFL). Weights mirror the ones the
  web app requests in frontend/src/index.css.

  Both the android: and app: namespaces are declared so the family resolves via
  AndroidX on API < 26 as well as natively on API 26+.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/poppins_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/poppins_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/poppins_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/poppins_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/poppins_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/poppins_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/poppins_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/poppins_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary button. Mirrors the web app's .btn-secondary, whose colour is the
  brand navy (secondary token) rather than the blue-grey this used to be.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_secondary_disabled" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_secondary_focus" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_secondary_pressed" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_secondary" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>

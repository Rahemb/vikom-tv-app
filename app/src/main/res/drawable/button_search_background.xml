<?xml version="1.0" encoding="utf-8"?>
<!--
  The contacts search button. Same four states and the same radius-sm corner as
  button_primary_background — it is a primary button and should not be the one
  square-cornered control in the app.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_disabled" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_focus" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_pressed" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Text input. Neutral fill with a border, gaining a primary-coloured border on
  focus — the same treatment Bootstrap form controls get in the web app.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_surface_muted" />
            <stroke
                android:width="2dp"
                android:color="@color/vk_primary" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_surface_muted" />
            <stroke
                android:width="1dp"
                android:color="@color/vk_border" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>

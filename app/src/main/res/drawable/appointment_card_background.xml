<?xml version="1.0" encoding="utf-8"?>
<!-- Appointment row. Same card grammar as the web portal: white surface, hairline
     border, radius-card corner; washes to light purple with a primary border when
     focused so the D-pad position is obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_surface" />
            <stroke android:width="3dp" android:color="@color/vk_primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_surface" />
            <stroke android:width="1dp" android:color="@color/vk_border" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>

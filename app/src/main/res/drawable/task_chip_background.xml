<?xml version="1.0" encoding="utf-8"?>
<!--
  Task pill on the appointment hero. The light-primary wash keeps the tasks
  readable as secondary information without competing with the status chip,
  which is the only saturated element on the card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vk_primary_surface" />
    <corners android:radius="@dimen/radius_pill" />
</shape>

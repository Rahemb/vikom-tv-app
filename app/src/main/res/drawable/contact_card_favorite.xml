<?xml version="1.0" encoding="utf-8"?>
<!--
  Favourite contact card. Same shape as the quick-dial card but carrying the
  light primary wash as its resting fill, so favourites read as distinct without
  introducing a second hue.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_surface" />
            <stroke
                android:width="3dp"
                android:color="@color/vk_primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/vk_primary_disabled" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-dial contact card. Was mint green, which has no counterpart in the web
  app's palette; now a white card with a hairline border like the portal's cards,
  washing to light purple with a primary border on focus.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_primary_surface" />
            <stroke
                android:width="3dp"
                android:color="@color/vk_primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vk_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/vk_border" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The marker on the timeline spine at the start of each day. The white ring
  makes it read as sitting on top of the spine rather than interrupting it;
  the fill colour is set in code per day (today / tomorrow / later).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/vk_primary" />
    <stroke
        android:width="4dp"
        android:color="@color/vk_surface" />
</shape>

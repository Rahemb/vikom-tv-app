<?xml version="1.0" encoding="utf-8"?>
<!--
  The main content surface. Matches the web app's card treatment: white fill,
  a hairline border, and the radius-card corner (20dp).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vk_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/vk_border" />
    <corners android:radius="@dimen/radius_card" />
</shape>
